diff --git a/src/kube_repair/benchmark_metrics.py b/src/kube_repair/benchmark_metrics.py
new file mode 100644
index 0000000..4f58339
--- /dev/null
+++ b/src/kube_repair/benchmark_metrics.py
@@ -0,0 +1,28 @@
+"""Canonical derived metrics for benchmark recording and evidence checking."""
+from __future__ import annotations
+
+import json
+from typing import Any
+
+
+def generation_seconds_from_responses(
+    calls: list[dict[str, Any]], counts_complete: bool,
+) -> float | None:
+    """Sum original integer nanoseconds before converting once to seconds.
+
+    Missing or invalid timing remains unavailable. Exact agreement between a
+    worker record and its verifier must not depend on float summation order.
+    """
+    if counts_complete is not True or not calls:
+        return None
+    nanoseconds = 0
+    for call in calls:
+        try:
+            response = json.loads(call.get("raw_server_response") or "null")
+        except (TypeError, ValueError):
+            return None
+        duration = response.get("eval_duration") if isinstance(response, dict) else None
+        if type(duration) is not int or duration < 0:
+            return None
+        nanoseconds += duration
+    return nanoseconds / 1_000_000_000
